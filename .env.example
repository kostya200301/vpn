# =====================================================================
#  Пример файла настроек. НЕ редактируйте .env вручную без необходимости:
#  install.sh создаёт .env из этого файла и сам генерирует все секреты.
#  Файл .env хранит секреты и не попадает в Git (см. .gitignore).
# =====================================================================

# ---------- Сервер ----------
# Публичный IPv4-адрес или домен VPS (определяется автоматически).
SERVER_ADDRESS=
# Короткая метка, добавляется к имени подключения в приложении (DE-phone).
SERVER_LABEL=DE

# ---------- Xray: VLESS + REALITY ----------
# Внешний TCP-порт VPN. 443 — лучший выбор для маскировки под HTTPS.
XRAY_PORT=443
# Сайт, под который маскируется REALITY (должен поддерживать TLS 1.3 и HTTP/2).
REALITY_SNI=www.microsoft.com
REALITY_TARGET=www.microsoft.com:443
# Ключи x25519 генерируются автоматически (xray x25519).
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
# TLS-отпечаток клиента (uTLS): chrome, firefox, safari, edge, ios, android, random...
CLIENT_FINGERPRINT=chrome

# ---------- Telegram: MTProto-прокси (mtg) ----------
# telegram — прокси включён; пусто — выключен.
COMPOSE_PROFILES=telegram
MTG_PORT=8443
# Домен для маскировки FakeTLS. Секрет генерируется автоматически (mtg generate-secret --hex).
MTG_DOMAIN=www.microsoft.com
MTG_SECRET=

# ---------- Обслуживание ----------
# yes — install.sh настраивает UFW (SSH всегда разрешается первым).
FIREWALL_MANAGE=yes
# yes — включить TCP BBR (ускоряет VPN на каналах с потерями).
ENABLE_BBR=yes
# Сколько последних резервных копий хранить.
BACKUP_KEEP=10

# ---------- Версии образов (необязательно) ----------
# По умолчанию используются версии, закреплённые в docker-compose.yml.
# XRAY_IMAGE=ghcr.io/xtls/xray-core:26.10.31
# MTG_IMAGE=nineseconds/mtg:2.2.8
